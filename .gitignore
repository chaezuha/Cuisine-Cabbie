# This .gitignore file should be placed at the root of your Unity project directory
#
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# plus custom IDE/OS and baked-lighting rules, merged and de-duplicated.

# ---- Unity generated folders ----
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size.
/[Rr]ecordings/

# ---- Logs / temp files ----
*.log
*.tmp

# By default Unity supports Blender asset imports; *.blend1 files do not need version control.
*.blend1
*.blend1.meta

# Uncomment this line if you wish to ignore the asset store tools plugin.
# /[Aa]ssets/AssetStoreTools*

# ---- IDE / Editor ----
# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# JetBrains Rider personal-layer settings
*.DotSettings.user
.idea/
# Visual Studio cache directory
.vs/
.vscode/
.consulo/
# Gradle cache directory
.gradle/

# ---- Autogenerated VS/MD/Consulo solution and project files ----
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.swp

# ---- Unity3D generated meta files ----
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Crash reports ----
sysinfo.txt
# Mono auto generated files
mono_crash.*

# ---- Builds ----
*.apk
*.aab
*.exe
*.app
*.unitypackage
*.unitypackage.meta

# ---- Crashlytics ----
crashlytics-build.properties

# ---- TestRunner generated files ----
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Addressables (default ignores, before user customizations) ----
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds generate addressables_content_state.bin
# files in platform-specific subfolders, e.g.
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ---- Visual Scripting auto-generated files ----
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ---- Auto-generated cache in Assets folder ----
/[Aa]ssets/[Ss]ceneDependencyCache*

# ---- Unity Baked Lighting ----
*.bakingset
*.lightingdata
*.ght
Lightmap-*

# Lightmaps
/Assets/**/*_Lightmap*.exr
/Assets/**/*_Lightmap*.png
/Assets/**/*_LightingData*
/Assets/**/*.lighting

# Light Probes & GI
/Assets/**/*LightProbes*
/Assets/**/*ReflectionProbe*
/Assets/**/*.giparams

# Adaptive Probe Volumes (APV)
/Assets/**/*.apv
/Assets/**/*ProbeVolumeBakingSet*
/Assets/**/*ProbeVolumeScenarios*

# Adaptive Probe Volumes (APV) / Baking Sets
*Baking Set*.bytes
*Baking Set*.bytes.meta
*Baking Set*.bakingset.meta
*.CellBricksData.bytes
*.CellSharedData.bytes
*.CellSupportData.bytes
*.CellData.bytes
*.CellOptionalData.bytes
*.CellProbeOcclusionData.bytes

# Lighting Data
LightingData.asset
LightingData.asset.meta

# GI Cache (already outside project but just in case)
/GiCache/
